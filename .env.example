# Arham Always Care WhatsApp helpline — environment variables.
# Copy to .env.local for local dev. Next.js loads it for the app; the worker, `npm run migrate`,
# `npm run ingest:ambulances` and `npm run eval` load .env.local and then .env themselves (dotenv),
# and a variable already set in the shell wins. Tests (vitest) read only the shell environment.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://arham:arham@localhost:5439/arham
# Test database (docker/docker-compose.dev.yml creates it). `npm test` reads it from the shell only;
# `npm run eval` also reads it from .env.local. Both default to arham_test on port 5439.
TEST_DATABASE_URL=postgres://arham:arham@localhost:5439/arham_test

# --- Interakt (WhatsApp Business provider) --------------------------------
INTERAKT_API_KEY=
# The secret set on the Interakt webhook. While it is empty, "hmac" mode refuses every webhook (403).
INTERAKT_WEBHOOK_SECRET=
# "hmac" in production. "off" accepts any body: only for local sandbox testing.
INTERAKT_WEBHOOK_VERIFY_MODE=hmac
# INTERAKT_API_BASE=https://api.interakt.ai/v1/public/message/

# --- Claude (owner's Max plan through the Agent SDK) -----------------------
# Generate on your laptop with `claude setup-token` (valid one year). Required by the claude-code
# backend: it runs the CLI with LLM_HOME_DIR as HOME, so a `claude login` on this machine is not used.
CLAUDE_CODE_OAUTH_TOKEN=
# ISO date you ran setup-token, e.g. 2026-09-25. Health endpoint counts down 365 days from it.
LLM_TOKEN_ISSUED_AT=
LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TURNS=6
LLM_TURN_TIMEOUT_MS=45000
# Writable directory the Claude CLI runs in: its HOME and cwd, with its config dir at <dir>/config (mode 0700).
LLM_HOME_DIR=/tmp/arham-claude-home
# "claude-code" (default) or "fake" (scripted backend for local UI work; refused when NODE_ENV=production).
LLM_BACKEND=claude-code

# --- Helpline identity ------------------------------------------------------
# Staffed number the bot may hand out when it cannot help (E.164).
HELPLINE_PHONE=
WEBSITE_URL=https://arhamalwayscare.org

# --- Admin page -------------------------------------------------------------
# At least 6 characters. Changing it, or SESSION_SECRET, logs every admin out.
ADMIN_PASSWORD=
# At least 32 random characters: `openssl rand -hex 32`
SESSION_SECRET=

# --- Ops --------------------------------------------------------------------
# Turns in flight at once (1-8), never two for the same conversation.
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# "1" logs raw webhook bodies (they contain phone numbers) at debug level, so it needs LOG_LEVEL=debug.
# Ignored when NODE_ENV=production.
LOG_RAW_WEBHOOKS=0
