# Arham Always Care WhatsApp helpline — environment variables.
# Copy to .env.local for local dev. Next.js loads it for the app; the worker, `npm run migrate`,
# `npm run ingest:ambulances` and `npm run eval` load .env.local and then .env themselves (dotenv),
# and a variable already set in the shell wins. Tests (vitest) read only the shell environment.
# On the Azure VM, this template becomes /opt/arham/.env: fill in the production values, including the
# "Production" section at the end (docs/runbooks/deploy.md).

# --- Database -------------------------------------------------------------
# On the VM the compose file sets DATABASE_URL itself (from POSTGRES_PASSWORD, below), whatever this says.
DATABASE_URL=postgres://arham:arham@localhost:5439/arham
# Test database (docker/docker-compose.dev.yml creates it). `npm test` reads it from the shell only;
# `npm run eval` also reads it from .env.local. Both default to arham_test on port 5439.
TEST_DATABASE_URL=postgres://arham:arham@localhost:5439/arham_test

# --- Interakt (WhatsApp Business provider) --------------------------------
# On the VM these can hold the real values before go-live: nothing reaches Interakt until its webhook
# points at the host (test-chat conversations never do).
INTERAKT_API_KEY=
# The secret set on the Interakt webhook. While it is empty, "hmac" mode refuses every webhook (403);
# with NODE_ENV=production the app and the worker refuse to start without it.
INTERAKT_WEBHOOK_SECRET=
# "hmac" in production (NODE_ENV=production refuses "off"). "off" accepts any body: only for local sandbox testing.
INTERAKT_WEBHOOK_VERIFY_MODE=hmac
# INTERAKT_API_BASE=https://api.interakt.ai/v1/public/message/

# --- Claude (owner's Max plan through the Agent SDK) -----------------------
# Generate on your laptop with `claude setup-token` (valid one year). Required by the claude-code
# backend: it runs the CLI with LLM_HOME_DIR as HOME, so a `claude login` on this machine is not used.
CLAUDE_CODE_OAUTH_TOKEN=
# ISO date you ran setup-token, e.g. 2026-09-25. Health endpoint counts down 365 days from it.
LLM_TOKEN_ISSUED_AT=
LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TURNS=6
LLM_TURN_TIMEOUT_MS=45000
# Writable directory the Claude CLI runs in: its HOME and cwd, with its config dir at <dir>/config (mode 0700).
# On the VM it is LLM_HOME_DIR=/home/node/claude-home, a volume the worker owns; the compose file sets it.
LLM_HOME_DIR=/tmp/arham-claude-home
# "claude-code" (default) or "fake" (scripted backend for local UI work; refused when NODE_ENV=production).
LLM_BACKEND=claude-code
# Extra usage past the Max plan's limit. "false" (the default, and the owner's decision): a reply extra usage already
# paid for is delivered, then Claude pauses until the limit resets. "true" lets turns run on extra usage. Keep extra
# usage off in the Claude account as well.
LLM_ALLOW_EXTRA_USAGE=false
# The fast path: a reporter's first message that names a place with exactly one unit (by area or city, no other
# request in it) gets that unit's card at once, without Claude. "true" (the default) or "false". A change applies when
# the worker starts with it: on the VM, `arham up -d` (`arham restart` keeps the old environment).
FAST_PATH_ENABLED=true

# --- Helpline identity ------------------------------------------------------
# Staffed number the bot may hand out when it cannot help (E.164).
HELPLINE_PHONE=
# The public website the welcome, the menu and the prompt point to. The bot itself runs at helpline.arhamalwayscare.org.
WEBSITE_URL=https://alwayscare.org

# --- Admin page -------------------------------------------------------------
# At least 6 characters. Changing it, or SESSION_SECRET, logs every admin out.
ADMIN_PASSWORD=
# At least 32 random characters: `openssl rand -hex 32`
SESSION_SECRET=

# --- Ops --------------------------------------------------------------------
# "production" on the server, for the worker too (`next start` sets it for the app): it refuses LLM_BACKEND=fake,
# webhook verification off and an empty webhook secret, marks the admin cookie Secure and ignores LOG_RAW_WEBHOOKS.
# On the VM the compose file sets NODE_ENV=production for the app and the worker, whatever this says.
# NODE_ENV=production
# The "service" field on every log line; set it apart for the app and the worker if they share a log stream.
# SERVICE_NAME=arham
# Turns in flight at once (1-8), never two for the same conversation.
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# "1" logs raw webhook bodies (they contain phone numbers) at debug level, so it needs LOG_LEVEL=debug.
# Ignored when NODE_ENV=production.
LOG_RAW_WEBHOOKS=0

# --- Production (the Azure VM's /opt/arham/.env; unused locally) ------------
# Read by docker/docker-compose.yml, Caddy and the backup service (docs/runbooks/deploy.md). A value with a `$` in it
# must be in single quotes: compose reads `$NAME` in this file as another variable. TEST_DATABASE_URL is not used there.
# The Postgres password, which also goes into the app's and the worker's database URL: hex only, `openssl rand -hex 24`.
# Postgres takes it only when its volume is first created: to change it later, run ALTER ROLE arham PASSWORD '<new>'
# in the database first, then edit it here and `arham up -d` (docs/runbooks/deploy.md).
POSTGRES_PASSWORD=
# The bot's hostname. Caddy gets its Let's Encrypt certificate once the DNS A record points at the VM.
PUBLIC_HOSTNAME=helpline.arhamalwayscare.org
# The Let's Encrypt account email (Caddy registers the ACME account with it).
ACME_EMAIL=
# Optional: an Azure Blob container SAS URL with Create permission only; each nightly dump is also uploaded there.
# Empty keeps the dumps on the VM only (/opt/arham/backups, 30 days).
AZURE_BACKUP_SAS_URL=
