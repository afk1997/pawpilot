# Arham Always Care WhatsApp helpline — environment variables.
# Copy to .env.local for local dev (Next.js) and export the same values for the
# worker (`npm run worker` reads .env.local via tsx --env-file in package scripts).

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://arham:arham@localhost:5432/arham
# Test database used by `npm test` (docker/docker-compose.dev.yml creates it).
TEST_DATABASE_URL=postgres://arham:arham@localhost:5432/arham_test

# --- Interakt (WhatsApp Business provider) --------------------------------
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
# "hmac" in production. "off" only for local sandbox testing.
INTERAKT_WEBHOOK_VERIFY_MODE=hmac
# INTERAKT_API_BASE=https://api.interakt.ai/v1/public/message/

# --- Claude (owner's Max plan through the Agent SDK) -----------------------
# Generate on your laptop with `claude setup-token` (valid one year).
CLAUDE_CODE_OAUTH_TOKEN=
# ISO date you ran setup-token, e.g. 2026-09-25. Health endpoint counts down.
LLM_TOKEN_ISSUED_AT=
LLM_MODEL=claude-sonnet-5
LLM_EFFORT=medium
LLM_MAX_TURNS=6
LLM_TURN_TIMEOUT_MS=45000
# Writable directory the SDK subprocess uses as HOME/config dir.
LLM_HOME_DIR=/tmp/arham-claude-home
# "claude-code" (default) or "fake" (scripted backend for local UI work).
LLM_BACKEND=claude-code

# --- Helpline identity ------------------------------------------------------
# Staffed number the bot may hand out when it cannot help (E.164).
HELPLINE_PHONE=
WEBSITE_URL=https://arhamalwayscare.org

# --- Admin page -------------------------------------------------------------
ADMIN_PASSWORD=
# At least 32 random characters: `openssl rand -hex 32`
SESSION_SECRET=

# --- Ops --------------------------------------------------------------------
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# "1" logs raw webhook bodies (contains phone numbers). Never in production.
LOG_RAW_WEBHOOKS=0
