# Caddy in front of the app (docker/docker-compose.yml). It obtains and renews the Let's Encrypt certificate for
# PUBLIC_HOSTNAME by itself, which needs the DNS A record pointing at the VM and ports 80 and 443 open, and redirects
# HTTP to HTTPS.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOSTNAME} {
	encode gzip
	reverse_proxy app:3000 {
		# The admin login limiter keys on the first X-Forwarded-For entry (src/app/api/admin/login/route.ts). Caddy
		# already drops a client-sent X-Forwarded-For (no trusted_proxies here); this makes the header the bare client
		# address whatever the defaults. It holds only while Caddy is the one thing facing the internet: never publish
		# the app's port 3000.
		header_up X-Forwarded-For {remote_host}
	}
}
