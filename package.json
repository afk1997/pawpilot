{
  "name": "arham-whatsapp-agent",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --import tsx src/server/worker/index.ts",
    "worker:dev": "tsx watch src/server/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "ingest:ambulances": "tsx scripts/ingest-ambulances.ts",
    "eval": "tsx evals/run.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "drizzle-orm": "^0.45.3",
    "next": "16.2.1",
    "pg-boss": "^12.34.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
